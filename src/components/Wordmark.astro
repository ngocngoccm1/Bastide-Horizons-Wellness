---
import {brand} from '../data/brand';
import {sitePath} from '../data/paths';
interface Props {href?:string;class?:string;}
const {href=sitePath('fr/'),class:className=''}=Astro.props;
---
<a class:list={['wordmark',className]} href={href} aria-label={brand.name}>
 {brand.logo ? <img src={brand.logo} alt={brand.name} width="220" height="56"/> : <><span>BASTIDE HORIZONS</span><small>WELLNESS</small></>}
</a>
