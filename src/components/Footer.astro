---
import Wordmark from './Wordmark.astro';
import {brand,languages,type Language} from '../data/brand';
import type {Translation} from '../data/translations';
import Arrow from './Arrow.astro';
interface Props {lang:Language;t:Translation;}
const {lang,t}=Astro.props;
---
<footer class="footer">
 <div class="footer-main container">
  <div class="footer-brand"><Wordmark href={`/${lang}/`}/><p>{t.footer.statement.split('\n').map(line=><>{line}<br/></>)}</p></div>
  <div><p class="eyebrow">{t.footer.explore}</p><nav aria-label={t.footer.explore}>{[['maison',t.nav.house],['hebergements',t.nav.stay],['bien-etre',t.nav.wellness],['provence',t.nav.region],['contact',t.nav.contact]].map(([id,label])=><a href={`/${lang}/#${id}`}>{label}</a>)}</nav></div>
  <div><p class="eyebrow">{t.footer.find}</p><address>{brand.address}</address><a class="text-link" href={brand.maps} target="_blank" rel="noopener noreferrer">{t.location.directions}<Arrow/></a>{brand.email&&<a href={`mailto:${brand.email}`}>{brand.email}</a>}{brand.phone&&<a href={`tel:${brand.phone}`}>{brand.phone}</a>}</div>
  <div><p class="eyebrow">{t.footer.languages}</p><nav aria-label={t.nav.language}>{Object.entries(languages).map(([code,l])=><a href={`/${code}/`} lang={l.locale} hreflang={l.locale} data-language-link aria-current={code===lang?'true':undefined}>{l.name}</a>)}</nav></div>
 </div>
 <div class="footer-bottom container"><span>© {new Date().getFullYear()} Bastide Horizons Wellness. {t.footer.copyright}</span><div><a href={`/${lang}/legal/`}>{t.footer.legal}</a><a href={`/${lang}/privacy/`}>{t.footer.privacy}</a><button data-cookie-open>{t.footer.cookies}</button><a href={`/${lang}/credits/`}>{t.footer.credits}</a></div></div>
</footer>
<dialog class="info-dialog" id="cookie-dialog" aria-labelledby="cookie-title"><button class="close-button" data-close aria-label={t.nav.close}>×</button><p class="eyebrow">{t.legal.eyebrow}</p><h2 id="cookie-title">{t.footer.cookies}</h2><p>{t.footer.cookiesText}</p><button class="button" data-map-reset>{t.footer.resetCookies}<Arrow/></button><p data-reset-status role="status"></p></dialog>
